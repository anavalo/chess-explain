{
  "manifest_version": 3,
  "name": "chess-explain",
  "version": "0.1",
  "description": "Explains why lichess's engine move is better. Stockfish runs in the browser.",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://lichess.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';" },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "chess-explain"
  }
}
