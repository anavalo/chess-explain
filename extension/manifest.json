{
  "manifest_version": 3,
  "name": "chess-explain",
  "version": "0.1",
  "description": "Explains why lichess's engine move is better, using a local server.",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "chess-explain"
  }
}
